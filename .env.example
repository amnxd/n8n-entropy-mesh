# Server Configuration
PORT=8080

# Safety: keep placeholders only in this file. Never put real secrets here.

# Database (Optional - you can manage this yourself)
DATABASE_URL=<postgres-connection-string>
ENABLE_DB=false

# Quote & Request Handling
QUOTE_TIMEOUT_SECONDS=120
MAX_QUOTES_TO_SHOW=3
MAX_QUOTES_TO_WAIT=3

# ============================================
# WhatsApp Cloud API Configuration (100% FREE!)
# ============================================
# 
# Get these credentials from:
# 1. Go to business.facebook.com
# 2. Create WhatsApp Business App (FREE)
# 3. Add your phone number (FREE)
# 4. Get Phone Number ID and Access Token (FREE)
#
# Setup Guide: https://business.facebook.com/help/
# API Docs: https://developers.facebook.com/docs/whatsapp/cloud-api

# Mode: 'mock' (for local testing) or 'cloud' (production)
WHATSAPP_MODE=mock

# Cloud API Credentials - Get from Meta Business Platform
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Webhook Timeout for sending messages
WHATSAPP_TIMEOUT_MS=10000

# ============================================
# Webhook Verification (Optional but Recommended)
# ============================================
# 
# When you set up the webhook in Meta Business Platform:
# 1. Choose a verify token (any string, e.g., "my_secret_verification_token")
# 2. Choose a secret (any string, e.g., "my_webhook_secret")
# 3. Meta will include the verify token when testing the webhook
# 4. All incoming messages will include x-hub-signature-256 header with HMAC-SHA256

# Verify token - Meta sends this when testing webhook setup
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<verify-token>

# Webhook secret - Used to verify signature in x-hub-signature-256 header
WHATSAPP_WEBHOOK_SECRET=

# Enable signature verification
WHATSAPP_WEBHOOK_VERIFY=false

# ============================================
# n8n AUTOMATION (Optional - FREE self-hosted)
# ============================================
#
# Add your n8n workflow webhook URL here to trigger automation
# whenever a user request is created.
# Example: http://localhost:5678/webhook/medsta-request-created
#
N8N_WEBHOOK_URL=
N8N_API_KEY=<shared-automation-key>
N8N_TIMEOUT_MS=5000

# ============================================
# SCALING OPTIONS (Optional - for high volume)
# ============================================
#
# These features are OPTIONAL but recommended for 1000+/day
# Enable them one at a time as you scale

# ============ DATABASE SCALING ==============
# Connection pool size for PostgreSQL
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# ============ REDIS CACHING ===============
# Optional Redis cache for provider availability & user state
# Install: npm install redis
# Then uncomment below to enable:
#
REDIS_ENABLED=false
REDIS_URL=<redis-connection-string>
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ JOB QUEUE ==================
# Optional Bull job queue for async broadcast
# Requires Redis
# Install: npm install bull
# Then uncomment below:
#
QUEUE_ENABLED=false

# ============ RATE LIMITING ==============
# Prevent abuse by rate limiting
# Install: npm install express-rate-limit
#
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000       # 1 minute window
RATE_LIMIT_MAX_REQUESTS=100      # 100 requests per window

# ============ MONITORING & METRICS =======
# Track requests, quotes, errors, response times
# Built-in, no installation needed
#
METRICS_ENABLED=true
METRICS_LOG_INTERVAL=0            # Set to 5 (every 5 minutes) for periodic logging
                                  # 0 = no logging (still available at /metrics endpoint)

# ============================================
# Quick Start for Scaling
# ============================================
#
# For 1000+/day, follow this order:
#
# 1. Setup PostgreSQL database:
#    ENABLE_DB=true
#    DATABASE_URL=postgres://...
#
# 2. Optional: Enable caching:
#    REDIS_ENABLED=true
#    REDIS_URL=redis://...
#
# 3. Optional: Enable async queue:
#    QUEUE_ENABLED=true
#
# 4. Monitor at endpoints:
#    GET /health              - Health check
#    GET /metrics             - JSON metrics
#    GET /metrics/prometheus  - Prometheus format
#    GET /cache/stats         - Cache statistics
#    GET /queue/stats         - Queue statistics
